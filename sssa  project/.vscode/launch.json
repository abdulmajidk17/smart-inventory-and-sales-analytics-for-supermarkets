{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Run Full Stack",
      "configurations": ["Flask", "React"]
    }
  ],
  "configurations": [
    {
      "name": "Flask",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "development"
      }
    },
    {
      "name": "React",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}/frontend"
    }
  ]
}

